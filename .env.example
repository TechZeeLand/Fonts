# Copy to .env (docker compose reads it automatically)
TZL_BASE_URL=https://fonts.example.com
TZL_ADMIN_USER=admin
# Leave empty to get a random password printed in `docker compose logs` on first start
TZL_ADMIN_PASSWORD=
# 1 when HTTPS is terminated by a reverse proxy in front of the container
TZL_TRUST_PROXY=0
